# GitHub OAuth Application Credentials
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: https://<your-domain>/api/auth/callback (or http://localhost:4321/api/auth/callback for local dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile Bot Protection
# Create a Turnstile widget in Cloudflare dashboard
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin Configuration
# GitHub username authorized to delete any guestbook entry
ADMIN_GITHUB_USERNAME=fiqrisr
