---
const links = [
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<nav
  aria-label="Section navigation"
  class="fixed top-4 left-1/2 -translate-x-1/2 z-overlay hidden md:flex border-2 border-black bg-bg-base shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
>
  {
    links.map((link, i) => (
      <a
        href={link.href}
        class:list={[
          "px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider",
          "hover:bg-secondary active:bg-primary",
          "transition-colors duration-150",
          i > 0 && "border-l-2 border-black",
        ]}
      >
        {link.label}
      </a>
    ))
  }
</nav>
