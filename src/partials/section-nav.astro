---
const links = [
  { href: "#experience", label: "Experience", ref: "001" },
  { href: "#projects", label: "Projects", ref: "002" },
  { href: "#skills", label: "Skills", ref: "003" },
  { href: "#contact", label: "Contact", ref: "004" },
];
---

<nav
  id="top-nav"
  aria-label="Section navigation"
  class="fixed top-12 left-1/2 -translate-x-1/2 z-overlay hidden md:flex border-2 border-black bg-bg-base shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 ease-in-out"
>
  {
    links.map((link, i) => (
      <a
        href={link.href}
        class:list={[
          "px-4 py-2 font-mono text-[11px] font-bold uppercase tracking-[0.08em]",
          "hover:bg-secondary active:bg-primary",
          "transition-colors duration-150",
          i > 0 && "border-l-2 border-black",
        ]}
      >
        <span class="text-hazard mr-1">{link.ref}</span>
        {link.label}
      </a>
    ))
  }
</nav>

<script>
  const nav = document.getElementById("top-nav");
  if (nav) {
    const handleScroll = () => {
      if (window.scrollY > 32) {
        nav.classList.replace("top-12", "top-6");
      } else {
        nav.classList.replace("top-6", "top-12");
      }
    };
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }
</script>
