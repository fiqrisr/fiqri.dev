---
import { portfolioData } from "../data/portfolio-data";

const { personal } = portfolioData;
---

<footer id="contact" class="bg-secondary border-t-4 border-black relative">
  {/* Hazard stripe at top of footer */}
  <div class="h-3 bg-hazard-stripes border-b-2 border-black" aria-hidden="true" />

  <span
    class="absolute top-8 left-6 font-mono text-xs text-black/20 select-none pointer-events-none"
    >&lt;footer&gt;</span
  >
  <span
    class="absolute bottom-4 right-6 font-mono text-xs text-black/20 select-none pointer-events-none"
    >&lt;/footer&gt;</span
  >

  <div class="py-20 px-4 md:px-8">
    <div class="max-w-7xl mx-auto w-full text-center">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="font-mono text-xs tracking-[0.08em] border-2 border-black px-2 py-1 bg-bg-base shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">[ FILE_REF: 004 ]</span>
      </div>
      <h2 class="font-heading mb-6">Let's Build Something</h2>
      <p
        class="text-fluid-body font-body text-border-dark max-w-xl mx-auto mb-10 leading-relaxed text-pretty"
      >
        I take on software engineering work — design systems, performance
        audits, and React/Next.js builds. If you have a project in mind, email
        me and I'll reply within two working days.
      </p>

      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12"
      >
        <a
          href={`mailto:${personal.email}`}
          class="inline-block px-8 py-4 font-heading font-bold text-xl border-4 border-black bg-primary shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-150"
        >
          {personal.email}
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <a
          href={personal.github}
          target="_blank"
          rel="me noopener noreferrer"
          class="inline-flex items-center px-5 py-3 font-mono text-sm font-bold border-4 border-black bg-bg-base shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-150"
        >
          GitHub
        </a>
        <a
          href={personal.linkedin}
          target="_blank"
          rel="me noopener noreferrer"
          class="inline-flex items-center px-5 py-3 font-mono text-sm font-bold border-4 border-black bg-bg-base shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-150"
        >
          LinkedIn
        </a>
        <a
          href={personal.instagram}
          target="_blank"
          rel="me noopener noreferrer"
          class="inline-flex items-center px-5 py-3 font-mono text-sm font-bold border-4 border-black bg-bg-base shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-150"
        >
          Instagram
        </a>
        <a
          href={personal.facebook}
          target="_blank"
          rel="me noopener noreferrer"
          class="inline-flex items-center px-5 py-3 font-mono text-sm font-bold border-4 border-black bg-bg-base shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-150"
        >
          Facebook
        </a>
        <a
          href={personal.x}
          target="_blank"
          rel="me noopener noreferrer"
          class="inline-flex items-center px-5 py-3 font-mono text-sm font-bold border-4 border-black bg-bg-base shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-150"
        >
          X (Twitter)
        </a>
      </div>

      <p class="mt-12 font-mono text-xs text-border-dark/60">
        © {new Date().getFullYear()}
        {personal.name}. Built with Astro, React & Tailwind CSS.
      </p>

      {/* Industrial spec line */}
      <div class="mt-6 pt-6 border-t-2 border-black/20 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-[10px] uppercase tracking-[0.1em] text-border-dark/50">
        <span>DOC / FSR-2026-001</span>
        <span>REV 2.6</span>
        <span class="bg-barcode h-4 w-16" aria-hidden="true" />
        <span>SHEET 01 / 01</span>
        <span>SCALE 1:1</span>
      </div>
    </div>
  </div>
</footer>
