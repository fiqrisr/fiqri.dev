---
import { portfolioData } from "../data/portfolio-data";

const { experience } = portfolioData;
const currentRole = experience[0];
const previousRoles = experience.slice(1);
---

<section
  id="experience"
  class="bg-graph-paper border-b-4 border-border-dark relative overflow-hidden"
>
  <span
    class="absolute top-4 left-6 font-mono text-xs text-border-dark/20 select-none pointer-events-none"
    >&lt;section id="experience-preview"&gt;</span
  >
  <span
    class="absolute bottom-4 right-6 font-mono text-xs text-border-dark/20 select-none pointer-events-none"
    >&lt;/section&gt;</span
  >

  <div class="py-16 md:py-20 px-4 md:px-8">
    <div class="max-w-7xl mx-auto w-full">
      <!-- Section Header -->
      <div class="mb-12 md:mb-16">
        <div class="flex items-end justify-between gap-4 mb-3 md:mb-4">
          <div class="flex items-center gap-2">
            <span
              class="font-mono text-xs md:text-sm tracking-[0.08em] border-2 border-border-dark px-2 py-1 inline-block bg-bg-base shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
            >
              [ FILE_REF: 001 ]
            </span>
            <span
              class="font-mono text-xs md:text-sm tracking-[0.08em] border-2 border-border-dark px-2 py-1 inline-block bg-secondary shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
            >
              SUMMARY_LOG
            </span>
          </div>
          <span class="bg-barcode h-6 w-24 hidden md:block" aria-hidden="true" />
        </div>

        <h2
          class="relative font-heading text-[clamp(2.5rem,8vw,6.5rem)] leading-[0.88] uppercase tracking-[-0.04em] text-hazard [-webkit-text-stroke:1px_#111111] md:[-webkit-text-stroke:2px_#111111] lg:[-webkit-text-stroke:3px_#111111]"
        >
          <span
            class="absolute top-0 left-0 translate-x-1 translate-y-1 md:translate-x-2 md:translate-y-2 text-border-dark select-none pointer-events-none"
            aria-hidden="true"
          >
            <span class="block">WORK</span>
            <span class="block">EXPERIENCE</span>
          </span>
          <span class="relative">
            <span class="block">WORK</span>
            <span class="block">EXPERIENCE</span>
          </span>
        </h2>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
          <div class="h-2 bg-hazard border-2 border-black w-full max-w-xs md:max-w-md" aria-hidden="true" />
          <p class="font-mono text-xs md:text-sm text-border-dark/70 tracking-wider">
            4+ YEARS PRODUCTION // 7 ORGANIZATIONS // 100K+ USERS
          </p>
        </div>
      </div>

      <!-- 2-Column Preview Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mb-10">
        <!-- Left: Featured Current Role (Lintasarta) -->
        <div class="lg:col-span-6 flex flex-col">
          <div
            class="flex-1 bg-primary border-4 border-black p-6 md:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] relative flex flex-col justify-between"
          >
            <!-- Corner crosshairs -->
            <span class="absolute top-2 left-2 font-mono text-[10px] text-border-dark/30 select-none pointer-events-none">+</span>
            <span class="absolute top-2 right-2 font-mono text-[10px] text-border-dark/30 select-none pointer-events-none">+</span>

            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="font-mono text-xs font-bold uppercase bg-border-dark text-bg-base px-3 py-1 border-2 border-black">
                  CURRENT ROLE // {currentRole.period}
                </span>
                <span class="font-mono text-[10px] font-black uppercase px-2.5 py-1 bg-secondary text-black border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] tracking-widest animate-pulse">
                  ACTIVE
                </span>
              </div>

              <h3 class="font-heading font-bold text-3xl md:text-4xl text-border-dark leading-tight mb-1">
                {currentRole.role}
              </h3>
              <p class="font-mono text-base font-bold text-border-dark/80 uppercase tracking-wide mb-1">
                @ {currentRole.company}
              </p>
              <p class="font-mono text-xs text-border-dark/60 mb-3">
                LOC: {currentRole.location}
              </p>

              <!-- Live Product Platform Callout -->
              <div class="mb-4 bg-bg-base border-2 border-black p-2.5 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] flex items-center justify-between gap-3">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="inline-block w-2 h-2 bg-accent shrink-0" aria-hidden="true" />
                  <span class="font-mono text-xs font-bold text-border-dark truncate">
                    PRODUCT: Lampu AI Marketplace
                  </span>
                </div>
                <a
                  href="https://lampu.ai"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[11px] font-bold border border-black bg-secondary text-black px-2 py-0.5 shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] hover:bg-primary transition-colors shrink-0 inline-flex items-center gap-1"
                >
                  <span>lampu.ai</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>

              <!-- Brief description -->
              <div class="bg-bg-base border-4 border-black p-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] mb-4">
                <p class="font-body text-xs md:text-sm text-border-dark leading-relaxed">
                  Leading architecture for the B2B AI Marketplace across Buyer and Seller platforms. Cut API server load by 40% via caching, reduced Docker images by 83% (3GB→500MB), achieved Rank #1 SEO, and integrated enterprise payment gateways.
                </p>
              </div>

              <!-- Active Tech Stack Chips -->
              <div class="mb-5">
                <span class="font-mono text-[10px] font-bold text-border-dark/70 uppercase tracking-wider block mb-2">
                  CORE TECH STACK:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {
                    ["React", "Next.js", "TypeScript", "TanStack Query", "Docker", "SonarQube", "Tailwind CSS"].map((tech) => (
                      <span class="font-mono text-[11px] font-bold bg-bg-base text-border-dark border-2 border-black px-2 py-0.5 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                        {tech}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>

            <div class="pt-3 border-t-2 border-black/30 flex items-center justify-between text-xs font-mono">
              <span class="text-border-dark/70 font-semibold">ARCH: REACT / NEXT.JS / TS</span>
              <a
                href="/experience#exp-lintasarta"
                class="font-bold underline hover:text-white transition-colors"
              >
                Full Dossier →
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Career History Index -->
        <div class="lg:col-span-6 flex flex-col">
          <div
            class="flex-1 bg-bg-base border-4 border-black p-6 md:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between border-b-2 border-black pb-3 mb-4">
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-border-dark">
                  CAREER_HISTORY // PRIOR ENGAGEMENTS
                </span>
                <span class="font-mono text-[10px] border border-black px-2 py-0.5 bg-secondary font-bold shrink-0">
                  {previousRoles.length} ARCHIVED
                </span>
              </div>

              <div class="divide-y-2 divide-black/15">
                {
                  previousRoles.map((role, idx) => (
                    <a
                      href={`/experience#${role.id}`}
                      class="group py-3 flex items-center justify-between gap-3 hover:bg-secondary/25 px-2 -mx-2 transition-colors block"
                    >
                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="font-mono text-[10px] text-border-dark/50 select-none">
                            [0{idx + 2}]
                          </span>
                          <span class="font-heading font-bold text-sm md:text-base text-border-dark group-hover:translate-x-1 transition-transform">
                            {role.company}
                          </span>
                        </div>
                        <p class="font-mono text-xs text-border-dark/70 truncate pl-6">
                          {role.role}
                        </p>
                      </div>

                      <div class="text-right shrink-0">
                        <span class="font-mono text-[11px] font-bold text-border-dark bg-black/5 px-2 py-0.5 border border-black/30">
                          {role.period}
                        </span>
                      </div>
                    </a>
                  ))
                }
              </div>
            </div>

            <div class="mt-6 pt-4 border-t-2 border-black flex items-center justify-between">
              <span class="font-mono text-xs text-border-dark/60">
                EDUCATION &amp; CERTS ARCHIVED
              </span>
              <span class="font-mono text-xs font-bold text-accent">
                TOTAL: 7 ROLES
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Banner: Link to Dedicated Experience Page -->
      <div
        class="border-4 border-black bg-secondary p-4 md:p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col sm:flex-row items-center justify-between gap-4"
      >
        <div class="flex items-center gap-3">
          <span class="text-2xl" aria-hidden="true">📂</span>
          <div>
            <div class="font-heading font-bold text-lg md:text-xl text-border-dark uppercase">
              Looking for full employment details &amp; credentials?
            </div>
            <div class="font-mono text-xs text-border-dark/80">
              Read the complete 7-role dossier with verified metrics, education, and professional certifications.
            </div>
          </div>
        </div>

        <a
          href="/experience"
          class="shrink-0 w-full sm:w-auto text-center font-heading font-bold text-sm md:text-base border-4 border-black bg-primary px-6 py-3 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150 inline-flex items-center justify-center gap-2"
        >
          <span>VIEW FULL CAREER DOSSIER</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
