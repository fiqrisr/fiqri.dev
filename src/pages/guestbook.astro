---

import Layout from "../layouts/layout.astro";
import SectionNav from "../partials/section-nav.astro";
import FooterCta from "../partials/footer-cta.astro";
import { RawModeToggle } from "../components/raw-mode-toggle";
import { GuestbookContainer } from "../components/guestbook-container";
import { portfolioData } from "../data/portfolio-data";

const { personal } = portfolioData;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
const allowAnonymousRaw =
  import.meta.env.PUBLIC_GUESTBOOK_ALLOW_ANONYMOUS ??
  import.meta.env.GUESTBOOK_ALLOW_ANONYMOUS;
const allowAnonymous =
  allowAnonymousRaw !== undefined
    ? !["false", "0", "no", "off", "disabled"].includes(
        String(allowAnonymousRaw).toLowerCase().trim(),
      )
    : true;
---

<Layout
  title={`Public Ledger & Guestbook | ${personal.name}`}
  description="Sign the public terminal guestbook on Fiqri Syah Redha's portfolio. Transmit a developer note, verify via GitHub, or drop feedback."
>
  <RawModeToggle client:load />
  <SectionNav />

  <main id="main-content" class="min-h-screen pt-36 pb-20 relative">
    {/* Background dot grid pattern is inherited from global.css */}

    <section class="max-w-5xl mx-auto px-4 sm:px-6 md:px-8 relative">
      {/* Decorative HTML tag annotations */}
      <span
        class="absolute -top-6 left-4 font-mono text-xs text-black/30 select-none pointer-events-none"
      >
        &lt;section class="guestbook"&gt;
      </span>
      <span
        class="absolute -bottom-6 right-4 font-mono text-xs text-black/30 select-none pointer-events-none"
      >
        &lt;/section&gt;
      </span>

      {/* Hero / Header banner */}
      <div
        class="border-4 border-black bg-secondary p-6 sm:p-10 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] mb-10 relative overflow-hidden"
      >
        <div
          class="h-3 bg-hazard-stripes border-b-2 border-black -mx-6 -mt-6 sm:-mx-10 sm:-mt-10 mb-6"
          aria-hidden="true"
        >
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
          <div class="flex items-center gap-2">
            <span
              class="font-mono text-xs font-bold tracking-wider px-2.5 py-1 bg-bg-base border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
            >
              [ FILE_REF: 005 ]
            </span>
            <span
              class="font-mono text-xs font-bold tracking-wider px-2.5 py-1 bg-primary border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
            >
              PUBLIC_LOG
            </span>
          </div>

          <a
            href="/"
            class="font-mono text-xs font-bold border-2 border-black px-3 py-1 bg-bg-base shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-primary transition-colors flex items-center gap-1.5"
          >
            ← BACK TO PORTFOLIO
          </a>
        </div>

        <h1
          class="font-heading font-bold text-fluid-h2 tracking-tight text-black mb-4 uppercase"
        >
          Terminal Guestbook
        </h1>

        <p
          class="font-body text-fluid-body text-border-dark max-w-2xl leading-relaxed text-pretty"
        >
          A persistent public ledger for developers, peers, and collaborators.
          Sign in with GitHub to verify your developer profile or transmit an anonymous note below.
        </p>

        {/* Industrial spec footer line */}
        <div
          class="mt-6 pt-4 border-t-2 border-black/20 flex flex-wrap items-center gap-x-6 gap-y-1 font-mono text-[10px] uppercase tracking-wider text-border-dark/70"
        >
          <span>STORAGE: CLOUDFLARE_D1_SQLITE</span>
          <span>BOT_GUARD: CLOUDFLARE_TURNSTILE</span>
          <span>AUTH: GITHUB_OAUTH_V3</span>
        </div>
      </div>

      {/* Main interactive guestbook island */}
      <GuestbookContainer
        client:load
        turnstileSiteKey={turnstileSiteKey}
        allowAnonymous={allowAnonymous}
      />
    </section>
  </main>

  <FooterCta />
</Layout>
